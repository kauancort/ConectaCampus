# PostgreSQL local (copie para .env e substitua todos os placeholders).
# Mantenha POSTGRES_PASSWORD e Password da connection string iguais.
POSTGRES_PORT=5432
POSTGRES_DB=conectacampus
POSTGRES_USER=conectacampus_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# No Compose, o host é postgres e a porta interna é sempre 5432.
# Ao executar dotnet no host, use Host=127.0.0.1 e a porta POSTGRES_PORT.
ConnectionStrings__DefaultConnection='Host=postgres;Port=5432;Database=conectacampus;Username=conectacampus_app;Password=replace-with-a-strong-local-password;SSL Mode=Disable'
# Render + Supabase: configure a variável acima diretamente no painel do Render.
# Use os dados de Connect > Session pooler (porta 5432, usuário postgres.<project-ref>).
# Exemplo SEM credenciais reais (formato Npgsql, não URL):
# Host=<session-pooler-host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password="<database-password>";SSL Mode=VerifyFull;Root Certificate=/etc/secrets/supabase-ca.crt;GSS Encryption Mode=Disable;Maximum Pool Size=10;Timeout=30;Command Timeout=60
# Faça upload da CA do Supabase como Secret File supabase-ca.crt no Render.
JWT_ISSUER=ConectaCampus.Api
JWT_AUDIENCE=ConectaCampus.Client
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=60
# No Render, informe a origem HTTPS exata do frontend (sem barra final).
# Cors__AllowedOrigins__0=https://<seu-frontend>.vercel.app
