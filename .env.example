# MySQL local do MVP (copie para .env e substitua as senhas)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=aprendizagem_colaborativa
MYSQL_USER=aprendizagem_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-password
JWT_ISSUER=ConectaCampus.Api
JWT_AUDIENCE=ConectaCampus.Client
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=60
